{
  "schema": "shifted-chain-certificates-v2",
  "producer": "experiments/shifted_chain_certificates.py",
  "model": {
    "stage": "(r,b) -> (c,r) of arity d: d>=2, 1<=c<b, (d+2)c <= d*b-r+1",
    "chain": "stages i=1..J from the source pair (r_1,b_1) to the terminal pair (1,t), built backward from (1,t) by the smallest parent b'=ceil(((d+2)r+b-1)/d); checked equal to the forward chain with the largest child c=floor((d*b-r+1)/(d+2))",
    "ramp": "ramp from (R,R) to (1,1): forward arities 3j, 3j-1 for j=R-1,...,1",
    "types": "(nK,nO,nmid) with nK+nO+nmid=N per sign, the same in all six orientations; a mode of M, certified by the exchange conditions",
    "sector_count": "M = N!/(nK! nO! nmid!) * (d-1)^nK * 2^nO",
    "exactification": "E = 1+6k(M-1) at every stage (Lu's separator, degree 6(M-1), over Q)",
    "counts": "A = prod_i d_i^(2Nk); B = t^(2Nk) prod_i M_i^(2k); r_* = s^(6Nk) prod_i (2M_i-1)^(6k) E_i; m_* = prod_i M_i^(6k); s = r_1+b_1-1",
    "p": "log(r_*/m_*)/log(B/A), the pooled exponent (v5 Lemma 2.4)",
    "Phi": "log(2 r_*/m_*)/log(B/A) = p + log 2/log(B/A), the fixed-batch bound (v5 (10.1))",
    "ceiling": "the log 2 term pays for the ceiling ceil(r_*/m_*) of the recursion without pooling (v5 Section 10.1); the pooled recursion also has ceilings ceil(nu_l/m_*) (v5 (2.9)), but they do not enter its exponent p",
    "least_k": "Phi strictly decreases in k and A increases in k for fixed chain, N and types; Phi at k-1 is certified >= target, so k and A are least for that chain, N and types",
    "field": "Q (rational interpolation, Lu's separator, rational exactification)",
    "selection": "the points are selected, not minimal"
  },
  "log_enclosure": {
    "mantissa_bits": 192,
    "series_terms": 110,
    "dyadic_bits": 320,
    "printed_decimals": 12,
    "printed_significant_digits_of_Phi_minus_p": 6,
    "rounding": "every printed bound is rounded outward"
  },
